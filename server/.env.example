# ==============================================================
# SmartDesk Backend Server Environment Configuration
# Copy this file to .env and provide your deployment credentials.
# NEVER commit real secret keys to source control.
# ==============================================================

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Supabase API Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key
SUPABASE_STORAGE_BUCKET_ATTACHMENTS=ticket-attachments
SUPABASE_STORAGE_BUCKET_DOCUMENTS=knowledge-documents

# AI / LLM Integration (gemini or openai)
AI_PROVIDER=gemini
LLM_API_KEY=your-gemini-or-openai-api-key
AI_MODEL_CHAT=gemini-1.5-flash
AI_MODEL_EMBEDDING=text-embedding-004
AI_EMBEDDING_DIMENSION=768
AI_RATE_LIMIT_PER_MINUTE=30

# Transactional Email (SMTP / Nodemailer)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM_ADDRESS=support@smartdesk.college.edu
EMAIL_FROM_NAME="SmartDesk College Support"
