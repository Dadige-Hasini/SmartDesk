{
  "name": "smartdesk",
  "version": "1.0.0",
  "description": "SmartDesk — AI-Powered College Student Help Desk",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "test": "npm --prefix server test && npm --prefix client test",
    "test:server": "npm --prefix server test",
    "test:client": "npm --prefix client test",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "seed": "node scripts/seed-runner.js",
    "evaluate:ml": "npm --prefix server run evaluate:ml",
    "evaluate:classifier": "npm --prefix server run evaluate:classifier"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
