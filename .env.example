# ==============================================================
# SmartDesk — Environment Configuration Template
# Copy this file to .env and fill in real values.
# NEVER commit real credentials to version control.
# ==============================================================

# Server Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Supabase Configuration
# Obtain from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_ANON_KEY is public and safe for client consumption
SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY is SERVER-ONLY and must NEVER be exposed to the client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# JWT Secret for backend token validation
SUPABASE_JWT_SECRET=your-jwt-secret-here

# Private Supabase Storage Buckets
SUPABASE_STORAGE_BUCKET_ATTACHMENTS=ticket-attachments
SUPABASE_STORAGE_BUCKET_DOCUMENTS=knowledge-documents

# AI & LLM Service Configuration (Server-Only)
# Options: gemini | openai | anthropic
AI_PROVIDER=gemini
AI_API_KEY=your-ai-api-key-here
AI_MODEL_CHAT=gemini-1.5-flash
AI_MODEL_EMBEDDING=text-embedding-004
AI_EMBEDDING_DIMENSION=768
AI_RATE_LIMIT_PER_MINUTE=20

# Email (SMTP / Nodemailer) Configuration (Server-Only)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM_ADDRESS=support@smartdesk.college.edu
EMAIL_FROM_NAME="SmartDesk Support"

# Client Vite Environment Variables (Exposed to browser with VITE_ prefix)
VITE_API_BASE_URL=http://localhost:5000/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
